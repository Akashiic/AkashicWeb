# AkashicWeb (português do Brasil). Textos de motivo usam no máximo um argumento (%s = detalhe, pode ser vazio).

# Blocos e itens
tile.akashicweb.screen.name=Tela Web
tile.akashicweb.screen.tooltip=Monte um retângulo plano (2x2 ou maior) e clique com o botão direito com a mão vazia.

# Mensagens
akashicweb.msg.formed=Tela montada: %sx%s blocos. Clique com o botão direito para abrir o navegador.

